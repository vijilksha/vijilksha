\par \hich\af31506\dbch\af31505\loch\f31506  
\par \hich\af31506\dbch\af31505\loch\f31506 Sample Input 1:
\par \hich\af31506\dbch\af31505\loch\f31506 Hell
\par \hich\af31506\dbch\af31505\loch\f31506 Sample Output 1:
\par \hich\af31506\dbch\af31505\loch\f31506 el
\par \hich\af31506\dbch\af31505\loch\f31506 public class UserMainCode \{
\par \hich\af31506\dbch\af31505\loch\f31506     public static String getMiddleChars(String str)
\par \hich\af31506\dbch\af31505\loch\f31506     \{
\par \hich\af31506\dbch\af31505\loch\f31506                 StringBuffer sb=new StringBuffer();
\par \hich\af31506\dbch\af31505\loch\f31506                  if(str.length()%2==0)
\par \hich\af31506\dbch\af31505\loch\f31506                  \{
\par \hich\af31506\dbch\af31505\loch\f31506                  sb.append(str.substring((str.length()/2)-1,(str.length()/2)+1));
\par \hich\af31506\dbch\af31505\loch\f31506                  \}
\par \hich\af31506\dbch\af31505\loch\f31506                  return sb.toString();
\par \hich\af31506\dbch\af31505\loch\f31506                  \}
\par \hich\af31506\dbch\af31505\loch\f31506     \}
